model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_date", "dim_incident_type", "dim_segment", "dim_time", "dim_weather", "fact_incident", "fact_traffic", "agg_roadtype_hour", "agg_segment_daily", "agg_zone_month", "mining_anomalies", "mining_association_rules", "mining_forecast", "mining_model_metrics", "mining_segment_clusters"]

ref expression DataFolder

ref table dim_date
ref table dim_incident_type
ref table dim_segment
ref table dim_time
ref table dim_weather
ref table fact_incident
ref table fact_traffic
ref table agg_roadtype_hour
ref table agg_segment_daily
ref table agg_zone_month
ref table mining_anomalies
ref table mining_association_rules
ref table mining_forecast
ref table mining_model_metrics
ref table mining_segment_clusters
ref table _Measures
